{
  "name": "family-finance-functions",
  "description": "Cloud Functions for Family Finance (membership, ledger, goals, budget FCM)",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "npm run build && node --test lib/ledger/*.test.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.0",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.7.3"
  },
  "private": true
}
